with "../flyology_simd.gpr";

project Examples is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/examples";
   for Exec_Dir use "../bin";
   for Main use
     ("find_byte.adb",
      "integer_vectors.adb",
      "floating_vectors.adb",
      "partial_tail.adb",
      "backend_selection.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end Examples;
