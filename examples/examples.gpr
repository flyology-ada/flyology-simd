with "../flyology_simd.gpr";

project Examples is
   type Architecture_Kind is ("scalar", "aarch64", "x86_64");
   Architecture : Architecture_Kind :=
     external ("FLYOLOGY_SIMD_ARCH", "scalar");
   type AVX2_Kind is ("disabled", "enabled");
   AVX2 : AVX2_Kind := external ("FLYOLOGY_SIMD_AVX2", "disabled");
   type Wide_Backend_Kind is ("composed", "avx2");
   Wide_Backend : Wide_Backend_Kind :=
     external ("FLYOLOGY_SIMD_WIDE_BACKEND", "composed");

   for Source_Dirs use (".");
   for Object_Dir use
     "../obj/examples/" & Architecture & "/" & AVX2 & "/" & Wide_Backend;
   for Exec_Dir use "../bin";
   for Main use
     ("find_byte.adb",
      "count_byte.adb",
      "integer_vectors.adb",
      "floating_vectors.adb",
      "partial_tail.adb",
      "backend_selection.adb",
      "inspect_delimited_bytes.adb",
      "count_digits.adb",
      "scale_measurements.adb",
      "dot_product.adb",
      "conversions.adb",
      "table_lookup.adb",
      "wide_table_lookup.adb",
      "wide_digit_classifier.adb",
      "lane_slides.adb",
      "permute_points.adb",
      "cross_block_differences.adb",
      "compact_measurements.adb",
      "wide_dot_product.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end Examples;
