with "../flyology_simd.gpr";

project Tests is
   type Architecture_Kind is ("scalar", "aarch64", "x86_64");
   Architecture : Architecture_Kind :=
     external ("FLYOLOGY_SIMD_ARCH", "scalar");
   type AVX2_Kind is ("disabled", "enabled");
   AVX2 : AVX2_Kind := external ("FLYOLOGY_SIMD_AVX2", "disabled");

   for Source_Dirs use (".");
   for Object_Dir use "../obj/tests/" & Architecture & "/" & AVX2;
   for Exec_Dir use "../bin";
   for Main use
     ("simd_tests.adb",
      "family_tests.adb",
      "conversion_tests.adb",
      "guard_page_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-O2");
   end Compiler;
end Tests;
