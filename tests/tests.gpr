with "../flyology_simd.gpr";

project Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin";
   for Main use ("simd_tests.adb", "family_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-O2");
   end Compiler;
end Tests;
