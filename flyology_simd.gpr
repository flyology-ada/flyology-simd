project Flyology_SIMD is
   type Architecture_Kind is ("scalar", "aarch64", "x86_64");
   Architecture : Architecture_Kind :=
     external ("FLYOLOGY_SIMD_ARCH", "scalar");

   type AVX2_Kind is ("disabled", "enabled");
   AVX2 : AVX2_Kind := external ("FLYOLOGY_SIMD_AVX2", "disabled");

   for Languages use ("Ada");
   for Source_Dirs use
     ("src", "src/backends/" & Architecture, "src/config/" & AVX2,
      "src/avx2/" & AVX2);
   for Object_Dir use "obj/" & Architecture & "/" & AVX2;
   for Library_Dir use "lib/" & Architecture & "/" & AVX2;
   for Library_Name use "flyology_simd";
   for Library_Kind use "static";

   package Compiler is
      Common_Ada :=
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatVa", "-fstack-check",
         "-fno-strict-aliasing");
      for Default_Switches ("Ada") use Common_Ada;

      case Architecture is
         when "aarch64" =>
            for Switches ("flyology_simd-backends-native.adb") use
              Common_Ada & ("-O3", "-ftree-vectorize");
         when "x86_64" =>
            for Switches ("flyology_simd-backends-native.adb") use
              Common_Ada &
                ("-O3", "-ftree-vectorize", "-msse2", "-mno-avx",
                 "-mno-avx2");
            case AVX2 is
               when "enabled" =>
                  for Switches ("flyology_simd-backends-avx2.adb") use
                    Common_Ada & ("-O3", "-mavx2");
                  for Switches ("flyology_simd-algorithms-avx2.adb") use
                    Common_Ada & ("-O3", "-mavx2");
               when "disabled" =>
                  null;
            end case;
         when others =>
            null;
      end case;
   end Compiler;
end Flyology_SIMD;
